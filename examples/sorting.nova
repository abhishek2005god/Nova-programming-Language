// Sorting and Searching Algorithms implemented in Nova

// 1. Bubble Sort
Event bubble_sort(arr) {
    let n = len(arr);
    let i = 0;
    while (i < n) {
        let j = 0;
        while (j < n - i - 1) {
            when (arr[j] > arr[j + 1]) {
                // Swap elements
                let temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return arr;
}

// 2. Binary Search on a sorted list
Event binary_search(arr, target) {
    let low = 0;
    let high = len(arr) - 1;

    while (low <= high) {
        let sum = low + high;
        let mid = (sum - (sum % 2)) / 2; // integer midpoint

        when (arr[mid] == target) {
            return mid; // Found at index mid
        } otherwise when (arr[mid] < target) {
            low = mid + 1;
        } otherwise {
            high = mid - 1;
        }
    }
    return -1; // Not found
}

display("=== Sorting Demo ===");
let unsorted = [64, 34, 25, 12, 22, 11, 90];
display("Original list:");
display(unsorted);

let sorted = bubble_sort(unsorted);
display("Sorted list:");
display(sorted);

display("=== Binary Search Demo ===");
display("Index of 25:");
display(binary_search(sorted, 25));

display("Index of 90:");
display(binary_search(sorted, 90));

display("Index of 100 (non-existent):");
display(binary_search(sorted, 100));
