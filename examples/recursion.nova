Event factorial(n) {
    when (n <= 1) {
        return 1;
    }

    return n * factorial(n - 1);
}

display(factorial(5));

Event fibonacci(n) {
    when (n <= 0) {
        return 0;
    } otherwise when (n == 1) {
        return 1;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

display(fibonacci(7));
